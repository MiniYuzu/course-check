/* 添加/编辑课程页样式 */

.page {
  min-height: 100vh;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 24rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #F1F5F9;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #1E293B;
}

.back-btn:active {
  background: #F1F5F9;
  border-radius: 50%;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1E293B;
}

.header-right {
  width: 64rpx;
}

/* 表单容器 */
.form-container {
  flex: 1;
  padding: 32rpx;
}

/* 表单区块 */
.form-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E293B;
  display: block;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.toggle-icon {
  font-size: 28rpx;
  color: #64748B;
}

/* 图标网格 */
.icon-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
  background: #F8FAFC;
  transition: all 0.2s;
}

.icon-item.selected {
  background: #EFF6FF;
  box-shadow: 0 0 0 2rpx #2563EB;
}

.icon-item:active {
  background: #F1F5F9;
}

.icon-emoji {
  font-size: 48rpx;
  line-height: 1;
}

.icon-name {
  font-size: 22rpx;
  color: #64748B;
}

/* 输入组 */
.input-group {
  margin-bottom: 32rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  font-size: 26rpx;
  color: #64748B;
  display: block;
  margin-bottom: 12rpx;
}

.input-field {
  height: 88rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #1E293B;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.input-field:focus {
  border-color: #2563EB;
  background: #fff;
}

.textarea-field {
  height: 200rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: #1E293B;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.input-hint {
  font-size: 24rpx;
  color: #94A3B8;
  margin-top: 8rpx;
  display: block;
}

/* 高级选项 */
.advanced-options {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.advanced-options.show {
  max-height: 600rpx;
  padding-top: 24rpx;
}

/* picker */
.picker-field {
  height: 88rpx;
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #1E293B;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #94A3B8;
  font-size: 32rpx;
}

/* 底部 */
.footer {
  background: #fff;
  border-top: 1rpx solid #F1F5F9;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

.save-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.3);
  transition: all 0.2s;
}

.save-btn::after {
  border: none;
}

.save-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.2);
}

.save-btn.disabled {
  background: #CBD5E1;
  box-shadow: none;
}

.bottom-spacer {
  height: 48rpx;
}
