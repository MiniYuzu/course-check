.form-hero { border-radius: 0 0 56rpx 56rpx; padding-bottom: 64rpx; }
.form-hero .hero-title { font-size: 46rpx; }
.form-content { padding-top: 36rpx; padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }
.small-heading { display: block; margin-bottom: 30rpx; color: #5C7090; font-size: 22rpx; font-weight: 600; letter-spacing: 1rpx; }
.field { margin-bottom: 30rpx; }
.field:last-child { margin-bottom: 0; }
.field-label { display: block; margin-bottom: 14rpx; color: #31415C; font-size: 28rpx; font-weight: 650; }
.optional { margin-left: 6rpx; color: #64728A; font-size: 22rpx; font-weight: 400; }
.input, .textarea { width: 100%; border: 1rpx solid #D7E0EE; border-radius: 24rpx; background: #F8FAFF; color: #30445F; font-size: 30rpx; line-height: 1.5; }
.input { height: 96rpx; padding: 0 26rpx; }
.input-placeholder { color: #74829A; }
.textarea { height: 180rpx; padding: 24rpx 26rpx; }
.type-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.type-item { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; min-width: 0; min-height: 138rpx; padding: 16rpx 4rpx; border: 4rpx solid transparent; border-radius: 28rpx; background: #F4F6FB; color: #60718A; font-size: 24rpx; }
.type-item.selected { border-color: #4563E9; color: #244ECA; background: #EEF3FF; font-weight: 650; }
.type-icon { display: block; font-size: 42rpx; line-height: 1.25; }
.type-check { position: absolute; top: 0; right: 0; display: flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border-radius: 0 20rpx 0 14rpx; background: #4563E9; color: #FFFFFF; font-size: 20rpx; line-height: 1; }
.number-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24rpx; }
.number-grid .field-label { font-size: 25rpx; white-space: nowrap; }
.number-input { position: relative; }
.number-grid .input { font-size: 40rpx; font-weight: 600; padding-right: 62rpx; padding-left: 24rpx; }
.number-placeholder { font-size: 34rpx; font-weight: 400; }
.number-unit { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%); font-size: 24rpx; color: #64728A; pointer-events: none; }
.form-total-note { display: flex; gap: 14rpx; background: #F1F5FF; border-radius: 22rpx; color: #556B8C; font-size: 24rpx; line-height: 1.75; padding: 22rpx 24rpx; margin-top: 24rpx; }
.info-icon { flex-shrink: 0; }
.form-note-emphasis { display: block; color: #835316; margin-top: 4rpx; }
.save-bar { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; padding: 24rpx 36rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); background: #FFFFFF; border-top: 1rpx solid #E7ECF6; }
.save-button { min-height: 96rpx; width: 100%; font-size: 30rpx; box-shadow: 0 10rpx 26rpx rgba(75, 80, 214, 0.15); }
.save-button[disabled] { box-shadow: none; }
.arrangement-heading { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.weekday-grid { display: flex; gap: 8rpx; margin: 20rpx 0; }
.weekday-button { flex: 1; margin: 0; padding: 12rpx 0; background: #F1F5F9; color: #64748B; font-size: 26rpx; border-radius: 14rpx; }
.weekday-button.selected { background: #EFF6FF; color: #2563EB; box-shadow: inset 0 0 0 2rpx #2563EB; }
.slot-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 12rpx; font-size: 26rpx; color: #475569; }
.time-picker { padding: 18rpx 20rpx; background: #F8FAFF; border-radius: 16rpx; color: #2563EB; }
.effective-date { display: flex; justify-content: space-between; gap: 12rpx; padding: 24rpx 0; margin-top: 12rpx; color: #475569; font-size: 26rpx; }
