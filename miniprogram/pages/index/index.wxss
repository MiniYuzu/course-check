/* 首页样式 - 活力版 */

.page {
  min-height: 100vh;
  background: #F0F4FF;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部区域 */
.header-section {
  position: relative;
  background: linear-gradient(135deg, #2563EB 0%, #7C3AED 100%);
  padding: 100rpx 32rpx 60rpx;
  color: #fff;
  overflow: hidden;
}

.header-bg-decoration {
  position: absolute;
  top: 80rpx;
  right: 40rpx;
}

.sparkle {
  font-size: 80rpx;
  opacity: 0.3;
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  display: block;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  display: block;
  margin-top: 12rpx;
}

/* 连续打卡徽章 */
.streak-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  margin-top: 24rpx;
  backdrop-filter: blur(10px);
}

.streak-icon {
  font-size: 32rpx;
}

.streak-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* 课程列表 */
.course-list {
  height: calc(100vh - 300rpx - 120rpx - env(safe-area-inset-bottom));
}

.list-container {
  padding: 20rpx;
}

/* 添加课程卡片 */
.add-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 40rpx;
  text-align: center;
  border: 2rpx dashed #CBD5E1;
  transition: all 0.2s;
}

.add-card:active {
  border-color: #2563EB;
  background: #EFF6FF;
  transform: scale(0.98);
}

.add-icon {
  width: 96rpx;
  height: 96rpx;
  background: #F1F5F9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #64748B;
  margin: 0 auto 16rpx;
}

.add-text {
  color: #64748B;
  font-size: 30rpx;
  font-weight: 500;
}

/* 底部占位 */
.bottom-spacer {
  height: 160rpx;
}
