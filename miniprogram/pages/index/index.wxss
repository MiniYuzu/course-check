page {
  background: #F0F4FF;
  color: #1E293B;
}

.home-page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 52rpx 48rpx 60rpx;
  background: linear-gradient(135deg, #2563EB 0%, #7C3AED 100%);
  color: #FFFFFF;
}

.hero-title {
  position: relative;
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.4;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  opacity: 0.9;
}

.hero-summary {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 26rpx;
}

.hero-sparkle {
  position: absolute;
  top: 28rpx;
  right: 48rpx;
  font-size: 100rpx;
  opacity: 0.3;
  pointer-events: none;
}

.home-content {
  padding: 36rpx;
}

.compact-reminder { width: 100%; display: flex; align-items: center; gap: 20rpx; min-height: 138rpx; box-sizing: border-box; padding: 22rpx 26rpx; margin-bottom: 20rpx; border-radius: 28rpx; background: #FFFFFF; text-align: left; line-height: 1.5; }
.compact-reminder .grow { min-width: 0; }
.reminder-symbol { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; flex-shrink: 0; background: #EFF6FF; color: #2563EB; font-size: 34rpx; }
.pending-symbol { background: #F5F3FF; color: #7C3AED; }
.reminder-title { display: block; color: #334155; font-size: 27rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.reminder-meta { display: block; color: #64748B; font-size: 22rpx; margin-top: 4rpx; }
.reminder-arrow { color: #94A3B8; font-size: 32rpx; }

.home-content .secondary {
  background: #E8EEFF;
  color: #2563EB;
}

.add-course {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  margin-top: 8rpx;
  padding: 40rpx;
  border: 4rpx dashed #CBD5E1;
  border-radius: 44rpx;
  background: #FFFFFF;
  color: #64748B;
  font-size: 30rpx;
  line-height: 1.5;
}

.add-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F1F5F9;
  color: #1E293B;
  font-size: 48rpx;
}

.hint {
  display: block;
  margin-top: 24rpx;
  color: #64748B;
}
