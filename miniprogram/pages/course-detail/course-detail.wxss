.detail-page { padding-top: 24rpx; }
.detail-hero { margin: 0 32rpx; border-radius: 46rpx; padding: 40rpx 42rpx 46rpx; background: #64748B; color: #FFFFFF; box-shadow: 0 20rpx 48rpx rgba(38, 120, 154, 0.12); }
.course-head { display: flex; gap: 24rpx; align-items: center; margin-bottom: 38rpx; }
.detail-icon { display: flex; justify-content: center; align-items: center; flex-shrink: 0; width: 96rpx; height: 96rpx; font-size: 48rpx; border-radius: 28rpx; background: rgba(255, 255, 255, 0.2); }
.course-title { display: block; font-size: 42rpx; font-weight: 700; line-height: 1.4; word-break: break-word; }
.course-schedule { display: block; margin-top: 6rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.9); word-break: break-word; }
.edit-link { flex-shrink: 0; border: 1rpx solid rgba(255, 255, 255, 0.35); border-radius: 40rpx; color: #FFFFFF; background: rgba(255, 255, 255, 0.1); font-size: 24rpx; padding: 14rpx 22rpx; min-height: 80rpx; }
.archive-badge { flex-shrink: 0; padding: 8rpx 12rpx; font-size: 22rpx; border-radius: 12rpx; background: rgba(255, 255, 255, 0.2); }
.balance-main { display: flex; justify-content: space-between; align-items: flex-end; gap: 16rpx; }
.remaining-label { display: block; font-size: 26rpx; }
.remaining-number { font-size: 90rpx; line-height: 1.2; font-weight: 750; word-break: break-all; }
.lesson-unit { font-size: 26rpx; font-weight: 500; margin-left: 10rpx; }
.balance-secondary { flex-shrink: 0; text-align: right; font-size: 26rpx; line-height: 1.9; padding-bottom: 8rpx; }
.balance-secondary text { display: block; }
.detail-track { height: 12rpx; margin-top: 32rpx; background: rgba(255, 255, 255, 0.28); border-radius: 12rpx; overflow: hidden; }
.detail-fill { height: 100%; background: #FFFFFF; border-radius: 12rpx; }
.balance-note { display: block; margin-top: 20rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.95); }
.compact-content { padding-top: 32rpx; }
.info-note { display: flex; gap: 16rpx; margin: 0 6rpx 28rpx; color: #64728A; font-size: 24rpx; line-height: 1.75; word-break: break-word; }
.info-icon { flex-shrink: 0; }
.field-date { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; border: 1rpx solid #E3EAFA; background: #F2F5FD; border-radius: 24rpx; padding: 24rpx; color: #526780; font-size: 26rpx; }
.date-value { color: #324F80; font-weight: 500; }
.date-arrow { padding-left: 8rpx; color: #64728A; }
.record-button { margin-top: 24rpx; width: 100%; min-height: 96rpx; font-size: 30rpx; }
.record-button.completed, .record-button.completed[disabled] { background: #10B981; color: #FFFFFF; opacity: 1; }
.lesson-note-editor { margin-top: 22rpx; border-top: 1rpx solid #EDF1F8; }
.note-disclosure { width: 100%; display: flex; justify-content: space-between; align-items: center; min-height: 84rpx; padding: 16rpx 0; color: #526780; background: transparent; font-size: 26rpx; font-weight: 600; text-align: left; }
.note-disclosure[disabled] { background: transparent; }
.optional { color: #64728A; font-size: 22rpx; font-weight: 400; margin-left: 8rpx; }
.disclosure-symbol { color: #8291A8; font-size: 32rpx; }
.note-input { display: block; width: 100%; height: 164rpx; border: 1rpx solid #D7E0EE; border-radius: 24rpx; padding: 22rpx 24rpx; color: #30445F; background: #F8FAFF; font-size: 28rpx; line-height: 1.65; }
.note-placeholder { color: #74829A; }
.note-foot { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 12rpx; color: #64728A; font-size: 22rpx; }
.note-save { padding: 8rpx 0; min-height: 64rpx; font-size: 24rpx; }
.limit-error { color: #B54359; }
.legacy-note-warning { display: block; font-size: 22rpx; margin-top: 8rpx; }
.history-count { font-size: 24rpx; color: #64728A; font-weight: 500; }
.timeline-hint { display: block; font-size: 23rpx; color: #64728A; margin-bottom: 28rpx; }
.timeline-record { display: flex; align-items: flex-start; gap: 22rpx; position: relative; padding-bottom: 30rpx; }
.timeline-record::before { content: ''; position: absolute; left: 40rpx; top: 84rpx; bottom: 0; border-left: 3rpx dashed #DCE5F5; }
.timeline-record:last-child { padding-bottom: 0; }
.timeline-record:last-child::before { display: none; }
.date-tile { position: relative; z-index: 1; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; border-radius: 50%; background: #EFF4FF; color: #5279B3; line-height: 1.3; }
.date-day { font-size: 34rpx; font-weight: 700; color: #365FA2; }
.date-weekday { font-size: 21rpx; margin-top: 2rpx; }
.record-body { flex: 1; min-width: 0; position: relative; border-radius: 30rpx; border: 1rpx solid #E9EDF6; background: #F8FAFF; overflow: hidden; }
.record-main { width: 100%; min-height: 128rpx; padding: 24rpx 88rpx 26rpx 24rpx; text-align: left; background: transparent; border-radius: 0; font-weight: 400; }
.record-main[disabled] { background: transparent; }
.record-title { font-size: 27rpx; font-weight: 600; color: #34455F; line-height: 1.5; }
.today-badge { color: #2857BD; background: #EDF3FF; border-radius: 6rpx; padding: 2rpx 6rpx; font-size: 18rpx; font-weight: 500; white-space: nowrap; }
.record-main .record-meta { font-size: 22rpx; line-height: 1.7; margin-top: 8rpx; }
.record-note { display: block; margin-top: 18rpx; color: #3E526F; font-size: 26rpx; line-height: 1.75; word-break: break-word; white-space: pre-wrap; }
.record-undo { position: absolute; top: 14rpx; right: 8rpx; padding: 16rpx 10rpx; min-height: 88rpx; min-width: 72rpx; font-size: 22rpx; }
.record-undo[disabled] { background: transparent; }
.more-button { width: 100%; margin-top: 20rpx; font-size: 24rpx; }
.archive-action { width: 100%; border: 1rpx solid #DCE4F2; border-radius: 26rpx; background: transparent; color: #61728D; min-height: 88rpx; font-size: 26rpx; }
.note-modal-mask { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 40rpx; background: rgba(20, 39, 71, 0.4); }
.note-dialog { width: 100%; max-width: 640rpx; overflow: hidden; border-radius: 36rpx; background: #FFFFFF; box-shadow: 0 24rpx 90rpx rgba(13, 36, 92, 0.15); }
.note-dialog-body { padding: 44rpx 38rpx 32rpx; }
.note-dialog-title { display: block; text-align: center; font-size: 34rpx; font-weight: 700; color: #25344D; }
.note-dialog-date { display: block; text-align: center; color: #64728A; font-size: 24rpx; margin: 12rpx 0 28rpx; word-break: break-word; }
.modal-input { height: 220rpx; }
.dialog-actions { display: flex; border-top: 1rpx solid #EDF0F7; }
.dialog-actions button { flex: 1; min-height: 100rpx; background: #FFFFFF; color: #64728A; border-radius: 0; }
.dialog-actions button + button { border-left: 1rpx solid #EDF0F7; color: #2563EB; font-weight: 600; }
.record-button.outcome { background: #EEF2F7; color: #475569; }
.timeline-filters { display: flex; gap: 8rpx; margin: 0 0 24rpx; }.filter-button { flex: 1; margin: 0; padding: 12rpx 0; font-size: 24rpx; background: #F1F5F9; color: #64748B; border-radius: 16rpx; }.filter-button.selected { color: #2563EB; background: #EFF6FF; }
.record-actions { display: flex; justify-content: flex-end; align-items: center; gap: 24rpx; padding: 0 20rpx 12rpx; }.record-actions button { margin: 0; font-size: 24rpx; min-height: 64rpx; }.future-hint { color: #94A3B8; font-size: 24rpx; }
.record-main { padding-right: 24rpx; }
