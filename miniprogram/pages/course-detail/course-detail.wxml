<view class="detail-page">
  <view wx:if="{{course}}" class="detail-hero {{course.type}}" style="background: {{courseGradient}};">
    <view class="course-head">
      <view class="detail-icon">{{course.icon || '📖'}}</view>
      <view class="grow"><text class="course-title">{{course.name}}</text><text class="course-schedule">{{course.schedule || '未设置固定上课时间'}}</text></view>
      <text wx:if="{{course.isDeleted}}" class="archive-badge">已归档</text>
      <button wx:else class="edit-link" bindtap="onEdit" disabled="{{!ready || busy}}">编辑</button>
    </view>
    <view class="balance-main">
      <view><text class="remaining-label">{{course.totalLessons ? '剩余课时' : '累计已上'}}</text><view class="remaining-number">{{course.totalLessons ? course.remainingCount : course.completedCount}}<text class="lesson-unit">节</text></view></view>
      <view class="balance-secondary"><text>已上 {{course.completedCount}} 节</text><text>{{course.totalLessons ? '共 ' + course.totalLessons + ' 节课' : '未设置总课时'}}</text></view>
    </view>
    <view wx:if="{{course.totalLessons}}" class="detail-track"><view class="detail-fill" style="width: {{course.progress}}%"></view></view>
    <text class="balance-note">其中 {{course.initialLessons}} 节为开始使用前已上</text>
    <text wx:if="{{course.overdrawnCount}}" class="balance-note">已超出 {{course.overdrawnCount}} 节，可{{course.isDeleted ? '恢复后' : ''}}编辑总课时</text>
  </view>
  <view class="page-content compact-content">
    <sync-status />
    <view wx:if="{{error}}" class="error-box">{{error}}<button class="secondary" bindtap="loadCourse">重新连接</button></view>
    <view wx:if="{{offline}}" class="warning">{{offline}}。本机修改会保留，联网后可重试。</view>
    <view wx:if="{{isLoading && !course}}" class="loading">正在读取课程…</view>
    <view wx:if="{{!isLoading && !course && !error}}" class="panel empty">没有找到这门课程，请返回首页刷新。</view>
    <block wx:if="{{course}}">
      <view class="info-note"><text class="info-icon">ⓘ</text><text class="grow">{{course.notes || '课程备注可在编辑中添加'}}</text></view>
      <view wx:if="{{!course.isDeleted}}" class="panel checkin-panel">
        <view class="section-row"><text class="section-title">记一节课</text><text class="badge">每天 1 节</text></view>
        <picker id="lesson-date" mode="date" start="1900-01-01" end="{{today}}" value="{{selectedDate}}" bindchange="onDateChange" disabled="{{busy || !ready}}">
          <view class="field-date"><text>上课日期</text><text class="date-value">{{selectedDate}} <text class="date-arrow">▾</text></text></view>
        </picker>
        <button id="record-lesson" class="primary record-button {{hasSelectedRecord ? 'completed' : ''}}" bindtap="onCheckin" loading="{{busy}}" disabled="{{busy || !ready || hasSelectedRecord}}">{{hasSelectedRecord ? (selectedDate === today ? '✓ 今日已打卡' : '✓ 这一天已记录') : (selectedDate === today ? '记录今天的课' : '补记这一天')}}</button>
        <view class="lesson-note-editor">
          <button id="toggle-lesson-note" class="note-disclosure" bindtap="onToggleNotes" disabled="{{busy || !ready}}"><text>记一句 <text class="optional">可选</text></text><text class="disclosure-symbol">{{noteOpen ? '−' : '＋'}}</text></button>
          <view wx:if="{{noteOpen}}" class="inline-note">
            <textarea id="lesson-note-inline" class="note-input" value="{{noteDraft}}" bindinput="onNotesInput" maxlength="{{noteDraft.length > 60 ? -1 : 60}}" placeholder="例如：今天第一次独立游完 25 米" placeholder-class="note-placeholder" disabled="{{busy || !ready}}" adjust-position="{{true}}" cursor-spacing="24" />
            <view class="note-foot"><button wx:if="{{hasSelectedRecord}}" id="save-inline-note" class="text-button note-save" bindtap="onSaveNotes" disabled="{{busy || !ready}}" loading="{{busy}}">保存备注</button><text wx:else>随这次记课一起保存</text><text class="{{noteDraft.length > 60 ? 'limit-error' : ''}}">{{noteDraft.length}} / 60</text></view>
            <text wx:if="{{noteDraft.length > 60}}" class="limit-error legacy-note-warning">原备注超过 60 字，完整保留；请精简后保存。</text>
          </view>
        </view>
        <text class="hint">选择过去的日期，可以补上忘记记录的课。</text>
      </view>
      <view wx:else class="warning">课程已归档，历史与备注仍可查看、修改。恢复后可继续记课。</view>
      <view class="panel history-panel">
        <view class="section-row"><view class="section-title">上课记录 <text class="history-count">· {{records.length}} 节</text></view><picker id="history-month" mode="date" fields="month" start="1900-01-01" end="{{today}}" value="{{month}}" bindchange="onMonthChange"><view class="picker">{{month || '全部月份'}} ▾</view></picker></view>
        <text wx:if="{{records.length}}" class="timeline-hint">点记录，可补写一句话</text>
        <view wx:if="{{!records.length}}" class="empty">{{month ? '这个月还没有上课记录' : '还没有逐条记录的课程'}}</view>
        <view class="lesson-timeline">
          <view wx:for="{{visibleRecords}}" wx:key="_id" class="timeline-record">
            <view class="date-tile"><text class="date-day">{{item.day}}</text><text class="date-weekday">{{item.weekday}}</text></view>
            <view class="record-body">
              <button class="record-main" data-record-id="{{item._id}}" data-date="{{item.date}}" bindtap="onOpenRecordNote" disabled="{{busy || !ready}}">
                <view class="record-title">已记录 1 节 <text wx:if="{{item.date === today}}" class="today-badge">今天</text></view>
                <text class="record-meta">{{item.dateLabel}} · {{item._syncStatus === 'failed' ? '同步失败 · 本机已保留' : (item._syncStatus && item._syncStatus !== 'synced' ? '已保存 · 待同步' : '已同步')}}</text>
                <text wx:if="{{item.notes}}" class="record-note">{{item.notes}}</text>
              </button>
              <button class="text-button danger record-undo" data-date="{{item.date}}" bindtap="onCancelCheckin" disabled="{{busy || !ready || !item.date}}">撤销</button>
            </view>
          </view>
        </view>
        <button wx:if="{{month}}" class="text-button more-button" bindtap="onAllMonths">查看全部月份</button>
        <button wx:if="{{visibleRecords.length < records.length}}" class="text-button more-button" bindtap="onLoadMore">再显示 30 条</button>
      </view>
      <button id="archive-course" class="archive-action" bindtap="onArchive" disabled="{{busy || !ready}}">{{course.isDeleted ? '恢复到首页' : '归档这门课程'}}</button>
      <text class="under-note">归档不会删除历史，随时可以恢复。</text>
    </block>
  </view>
  <view wx:if="{{noteModalOpen}}" class="note-modal-mask" catchtap="onCloseNoteModal" catchtouchmove="onModalTouchMove">
    <view class="note-dialog" catchtap="onModalTouchMove">
      <view class="note-dialog-body">
        <text class="note-dialog-title">记一句</text>
        <text class="note-dialog-date">{{modalCourseName}} · {{modalDateLabel}}</text>
        <textarea id="lesson-note-dialog" class="note-input modal-input" value="{{modalNotes}}" bindinput="onModalNotesInput" maxlength="{{modalNotes.length > 60 ? -1 : 60}}" placeholder="留下一点值得记住的小进步" placeholder-class="note-placeholder" disabled="{{busy}}" adjust-position="{{true}}" fixed="{{true}}" cursor-spacing="32" show-confirm-bar="{{false}}" />
        <view class="note-foot"><text>留空保存，可清除备注</text><text class="{{modalNotes.length > 60 ? 'limit-error' : ''}}">{{modalNotes.length}} / 60</text></view>
        <text wx:if="{{modalNotes.length > 60}}" class="limit-error legacy-note-warning">原备注完整保留，请精简至 60 字后保存。</text>
      </view>
      <view class="dialog-actions"><button id="cancel-note-dialog" bindtap="onCloseNoteModal" disabled="{{busy}}">取消</button><button id="save-note-dialog" bindtap="onSaveModalNotes" loading="{{busy}}" disabled="{{busy || !ready}}">保存备注</button></view>
    </view>
  </view>
</view>
