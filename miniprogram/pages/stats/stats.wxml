<view class="stats-page">
  <view class="hero stats-hero">
    <text class="hero-sparkle" aria-hidden="true">✦</text><text class="hero-title">每一节，都算数。</text><text class="hero-subtitle">把坚持留在记录里</text>
    <view class="hero-metrics"><view class="hero-metric"><text class="hero-number">{{hasData ? summary.totalLessons : '—'}}</text><text class="hero-label">累计已上 / 节</text></view><view class="hero-metric"><text class="hero-number">{{hasData ? summary.activeCourses : '—'}}</text><text class="hero-label">正在上的课程</text></view></view>
    <text class="hero-tiny">{{hasData ? '含初始已上 ' + summary.initialLessons + ' 节 · 归档历史仍计入累计' : '连接后读取完整课时账本'}}</text>
  </view>
  <view class="page-content">
    <sync-status />
    <view wx:if="{{error}}" class="error-box">{{error}}<button class="secondary" bindtap="loadStats">重新连接</button></view>
    <view wx:if="{{offline}}" class="warning">{{offline}}。以下为本机保留的记录，可能还不是最新数据。</view>
    <view wx:if="{{isLoading && !hasData}}" class="loading">正在读取完整记录…</view>
    <block wx:if="{{ready && hasData}}">
      <view class="panel week-panel">
        <view class="section-row"><text class="section-title">最近 7 天</text><text class="week-total">共 {{weekTotal}} 节</text></view>
        <text class="chart-hint">每天一小步，成长看得见 · 不随月份切换</text>
        <view class="week-chart"><view wx:for="{{summary.week}}" wx:key="date" class="chart-column {{item.isToday ? 'today' : ''}}"><text class="bar-count">{{item.count}}</text><view class="bar-track"><view class="bar {{item.isToday ? 'today' : ''}}" style="height: {{item.height}}%"></view></view><text class="bar-label">{{item.label}}</text></view></view>
      </view>
      <view class="panel month-panel">
        <view class="section-row"><text class="section-title">月度记录</text><picker id="stats-month" mode="date" fields="month" start="1900-01-01" end="{{today}}" value="{{month}}" bindchange="onMonthChange"><view class="picker">{{month}} ▾</view></picker></view>
        <view class="month-metrics"><view class="metric"><text class="metric-label">实际记录课时</text><view class="metric-number">{{summary.monthLessons}}<text>节</text></view></view><view class="metric orange"><text class="metric-label">有课的天数</text><view class="metric-number">{{activeDays}}<text>天</text></view></view></view>
        <text class="hint">只按上课日期统计，不含没有具体日期的初始课时。</text>
        <text class="hint">本月实际消耗 {{summary.monthConsumedLessons}} 节（含缺席扣课，和实际出席分开计算）。</text>
        <view class="month-outcome-links"><button class="text-button" data-filter="absent" bindtap="onAttendanceTap">缺席 {{monthAbsentCount}} 次 ›</button><button class="text-button" data-filter="pending" bindtap="onAttendanceTap">待确认 {{monthPendingCount}} 条 ›</button></view>
      </view>
      <view class="panel distribution-panel">
        <view class="section-row"><text class="section-title">各课程记录</text><text class="muted">{{month}}</text></view>
        <view wx:if="{{!monthCourses.length}}" class="empty">这个月还没有上课记录。</view>
        <button wx:for="{{monthCourses}}" wx:key="_id" class="distribution-row {{item.type}}" data-id="{{item._id}}" bindtap="onCourseTap"><view class="mini-emoji {{item.type}}">{{item.icon || '📖'}}</view><view class="grow"><text class="record-name">{{item.name}} <text wx:if="{{item.isDeleted}}" class="archive-label">已归档</text></text><view class="track"><view class="track-fill" style="width: {{item.monthPercent}}%"></view></view></view><view class="course-amount">{{item.monthCount}} <text>节 ›</text></view></button>
      </view>
      <view class="panel records-panel">
        <view class="section-row"><text class="section-title">上课明细</text><text class="muted">{{monthRecords.length}} 条</text></view>
        <view wx:if="{{!monthRecords.length}}" class="empty">选择其他月份查看历史。</view>
        <button wx:for="{{visibleRecords}}" wx:key="_id" class="row record-row detail-record" data-id="{{item.courseId}}" bindtap="onCourseTap"><view class="mini-emoji">{{item.icon || '📖'}}</view><view class="grow"><text class="record-name">{{item.courseName}}</text><text class="record-meta">{{item.date}}{{item.archived ? ' · 已归档' : ''}}</text></view><text class="badge">1 节</text></button>
        <button wx:if="{{visibleRecords.length < monthRecords.length}}" class="text-button more-button" bindtap="onLoadMore">再显示 30 条</button>
      </view>
    </block>
  </view>
</view>
