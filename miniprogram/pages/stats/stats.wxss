.stats-hero { border-radius: 0 0 56rpx 56rpx; padding-bottom: 60rpx; }
.hero-metrics { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20rpx; margin-top: 36rpx; }
.hero-metric { min-width: 0; padding: 26rpx 28rpx; border: 1rpx solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.09); border-radius: 32rpx; }
.hero-number { display: block; font-size: 68rpx; font-weight: 750; line-height: 1.2; word-break: break-all; }
.hero-label { display: block; margin-top: 12rpx; font-size: 24rpx; color: rgba(255, 255, 255, 0.95); }
.hero-tiny { display: block; margin-top: 24rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.92); }
.week-total { font-size: 24rpx; color: #526780; }
.chart-hint { display: block; font-size: 22rpx; color: #64728A; margin-bottom: 24rpx; }
.week-chart { display: flex; align-items: stretch; gap: 20rpx; padding-top: 12rpx; }
.chart-column { flex: 1; display: flex; flex-direction: column; align-items: center; min-width: 0; }
.bar-count { font-size: 22rpx; color: #566E9B; font-weight: 600; margin-bottom: 10rpx; }
.bar-track { width: 100%; height: 152rpx; display: flex; align-items: flex-end; justify-content: center; border-bottom: 1rpx solid #EDF1F8; }
.bar { width: 46rpx; max-width: 100%; min-height: 6rpx; background: #C8D6FB; border-radius: 10rpx 10rpx 4rpx 4rpx; }
.bar.today { background: #10B981; }
.bar-label { margin-top: 14rpx; font-size: 20rpx; color: #62738F; white-space: nowrap; }
.chart-column.today .bar-label, .chart-column.today .bar-count { color: #087957; font-weight: 700; }
.month-metrics { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24rpx; }
.metric { padding: 28rpx; border-radius: 30rpx; background: #F1F5FF; }
.metric.orange { background: #FFF4EB; }
.metric-label { color: #64728A; font-size: 24rpx; }
.metric-number { color: #2563EB; font-size: 62rpx; font-weight: 700; line-height: 1.4; margin-top: 6rpx; word-break: break-all; }
.metric.orange .metric-number { color: #B66B18; }
.metric-number text { margin-left: 10rpx; font-size: 24rpx; font-weight: 400; color: #64728A; }
.distribution-row { width: 100%; display: flex; align-items: center; gap: 22rpx; padding: 24rpx 0; border-top: 1rpx solid #EDF1F8; background: transparent; text-align: left; border-radius: 0; }
.distribution-row .record-name { font-size: 27rpx; }
.distribution-row .track { margin-top: 16rpx; }
.distribution-row.piano .track-fill { background: linear-gradient(135deg, #F59E0B 0%, #EF4444 100%); }
.course-amount { flex-shrink: 0; color: #3F577D; font-size: 28rpx; font-weight: 600; }
.course-amount text { font-size: 24rpx; font-weight: 400; }
.archive-label { color: #64728A; font-size: 21rpx; font-weight: 400; }
.detail-record { width: 100%; background: transparent; text-align: left; border-radius: 0; }
.detail-record .record-name { font-size: 27rpx; }
.detail-record .record-meta { margin-top: 6rpx; font-size: 23rpx; }
.more-button { width: 100%; margin-top: 12rpx; }
.month-outcome-links { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 16rpx; }.month-outcome-links button { font-size: 24rpx; padding: 12rpx 0; margin: 0; }
