/* 统计页样式 - 活力版 */

.page {
  min-height: 100vh;
  background: #F0F4FF;
  display: flex;
  flex-direction: column;
}

/* 顶部 */
.header {
  position: relative;
  background: linear-gradient(135deg, #2563EB 0%, #7C3AED 100%);
  padding: 100rpx 32rpx 60rpx;
  color: #fff;
  overflow: hidden;
}

.header-bg-decoration {
  position: absolute;
  top: -100rpx;
  right: -60rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  display: block;
  position: relative;
  z-index: 1;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  display: block;
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
}

/* 内容区 */
.content {
  flex: 1;
  padding: 0 24rpx;
}

/* 总览卡片 */
.overview-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.overview-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #1E293B;
}

.overview-label {
  font-size: 22rpx;
  color: #64748B;
}

/* 区块 */
.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

/* 周打卡图表 */
.week-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 240rpx;
  padding: 0 16rpx;
}

.chart-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.bar-fill {
  width: 32rpx;
  background: linear-gradient(180deg, #2563EB 0%, #3B82F6 100%);
  border-radius: 16rpx;
  min-height: 8rpx;
  transition: height 0.3s ease;
}

.bar-day {
  font-size: 22rpx;
  color: #64748B;
}

.bar-count {
  font-size: 20rpx;
  color: #94A3B8;
}

/* 课程排行 */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.rank-num {
  width: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #94A3B8;
  text-align: center;
}

.rank-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.rank-icon.swim {
  background: #EFF6FF;
}

.rank-icon.piano {
  background: #FEF3C7;
}

.rank-icon.english {
  background: #D1FAE5;
}

.rank-icon.art {
  background: #FCE7F3;
}

.rank-icon.dance {
  background: #EDE9FE;
}

.rank-icon.sports {
  background: #FFEDD5;
}

.rank-icon.music {
  background: #CFFAFE;
}

.rank-icon.other {
  background: #F1F5F9;
}

.rank-info {
  flex: 1;
}

.rank-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1E293B;
  display: block;
  margin-bottom: 8rpx;
}

.rank-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rank-progress .progress-bar {
  flex: 1;
  height: 8rpx;
  background: #F1F5F9;
  border-radius: 4rpx;
  overflow: hidden;
}

.rank-progress .progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563EB 0%, #3B82F6 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.rank-progress .progress-text {
  font-size: 24rpx;
  color: #64748B;
  min-width: 60rpx;
  text-align: right;
}

/* 月度统计 */
.month-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #2563EB;
  font-weight: 500;
}

.picker-arrow {
  font-size: 20rpx;
}

.month-stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
}

.month-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.month-stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #1E293B;
}

.month-stat-label {
  font-size: 26rpx;
  color: #64748B;
}

.bottom-spacer {
  height: 160rpx;
}
