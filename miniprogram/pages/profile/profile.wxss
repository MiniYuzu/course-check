.profile-hero { border-radius: 0 0 56rpx 56rpx; padding-bottom: 64rpx; }
.account-lock { display: block; margin-top: 24rpx; color: rgba(255, 255, 255, 0.9); font-size: 24rpx; }
.sync-panel { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 20rpx; row-gap: 22rpx; align-items: center; }
.sync-top { display: flex; align-items: center; gap: 18rpx; min-width: 0; }
.sync-symbol { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 72rpx; height: 72rpx; border-radius: 24rpx; color: #14A279; background: #E7F8F2; font-size: 40rpx; font-weight: 500; }
.sync-symbol.pending { background: #FFF2E3; color: #B58025; }
.sync-symbol.error { background: #FFECEF; color: #C05266; }
.sync-title { display: block; color: #2F435E; font-size: 29rpx; font-weight: 700; line-height: 1.5; }
.sync-description { display: block; margin-top: 6rpx; color: #64728A; font-size: 23rpx; line-height: 1.65; }
.sync-button { grid-column: 2; grid-row: 1; min-width: 144rpx; max-width: 168rpx; min-height: 88rpx; border-radius: 24rpx; padding: 20rpx 18rpx; font-size: 24rpx; }
.is-error { border-color: #F0D5DE; }
.is-error .sync-title { color: #A54157; }
.is-error .sync-button { background: #FFF2F5; color: #AC425A; border: 1rpx solid #EFC4CF; }
.is-pending .sync-button { background: #FFF6E7; color: #885D1B; border: 1rpx solid #EDD9B5; }
.pending-item { grid-column: 1 / -1; display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; padding-top: 24rpx; border-top: 1rpx solid #EDF1F8; font-size: 24rpx; }
.pending-name { display: block; color: #50647F; word-break: break-word; }
.pending-badge { flex-shrink: 0; border-radius: 10rpx; padding: 4rpx 10rpx; background: #FFF4DF; color: #8B5C0C; font-size: 21rpx; }
.pending-badge.failed { color: #AE4359; background: #FFF0F2; }
.failure-reason { display: block; color: #A34359; font-size: 22rpx; margin-top: 8rpx; line-height: 1.7; word-break: break-word; }
.sync-reason { grid-column: 1 / -1; margin: 0; }
.archive-empty { color: #64728A; font-size: 24rpx; line-height: 1.75; padding: 12rpx 0 16rpx; text-align: center; }
.archive-row { display: flex; align-items: center; gap: 18rpx; padding-top: 24rpx; border-top: 1rpx solid #EDF1F8; }
.archive-row + .archive-row { margin-top: 22rpx; }
.archive-open { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0; min-height: 88rpx; padding: 0; background: transparent; text-align: left; }
.archive-open .record-name { font-size: 27rpx; }
.archive-open .record-meta { margin-top: 6rpx; font-size: 22rpx; }
.restore-button { min-width: 88rpx; font-size: 24rpx; }
.menu { padding: 6rpx 34rpx; }
.menu-button { display: flex; align-items: center; gap: 24rpx; width: 100%; min-height: 114rpx; padding: 26rpx 0; background: #FFFFFF; color: #405571; text-align: left; border-bottom: 1rpx solid #EDF1F8; border-radius: 0; font-size: 27rpx; }
.menu-button:last-child { border-bottom: 0; }
.menu-icon { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; border-radius: 18rpx; background: #EFF3FC; color: #5D7BAC; font-size: 36rpx; font-weight: 500; flex-shrink: 0; }
.chevron { color: #A9B6CD; font-size: 36rpx; }
.profile-foot { display: block; padding: 20rpx 0 24rpx; text-align: center; color: #64728A; font-size: 22rpx; line-height: 1.9; white-space: pre-line; }
