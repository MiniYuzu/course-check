<view class="profile-page">
  <view class="hero profile-hero"><text class="hero-sparkle" aria-hidden="true">✦</text><text class="hero-title">我的课时账本</text><text class="hero-subtitle">课程有记录，数据有着落。</text><text class="account-lock">仅属于当前微信账户 · 不公开分享</text></view>
  <view class="page-content">
    <view wx:if="{{error}}" class="error-box">{{error}}<button class="secondary" bindtap="loadProfile">重新连接</button></view>
    <view wx:if="{{offline}}" class="warning">{{offline}}。本机数据保留，联网后可核对云端。</view>
    <view class="panel sync-panel {{queueStats.failed ? 'is-error' : (queueStats.total ? 'is-pending' : '')}}">
      <view class="sync-top">
        <view class="sync-symbol {{queueStats.failed ? 'error' : (queueStats.total || error || offline || !ready ? 'pending' : '')}}">{{queueStats.failed ? '!' : (syncing || queueStats.syncing ? '↻' : (queueStats.total ? '↑' : (error || offline || !ready || isLoading ? '○' : '✓')))}}</view>
        <view class="grow"><text class="sync-title">{{syncing || queueStats.syncing ? '正在同步记录' : (queueStats.failed ? '有 ' + queueStats.failed + ' 项同步失败' : (queueStats.total ? '有 ' + queueStats.total + ' 项等待同步' : (error || offline ? '尚未核对云端' : (isLoading ? '正在读取记录' : (ready ? '记录已同步' : '请先确认账号')))))}}</text><text class="sync-description">{{queueStats.total ? '修改已保存在本机，请勿清理缓存。' : (error || offline ? '没有待上传修改，云端状态待确认。' : (ready ? '没有待上传的本机修改' : '联网确认账号后可读取记录'))}}</text></view>
      </view>
      <button id="sync-records" class="secondary sync-button" bindtap="onSyncTap" loading="{{syncing}}" disabled="{{syncing || adopting || queueStats.syncing}}">{{syncing || queueStats.syncing ? '同步中' : (queueStats.failed || error || offline ? '立即重试' : (queueStats.total ? '立即同步' : '同步记录'))}}</button>
      <button wx:if="{{conflictOperationId}}" class="text-button cloud-adoption" bindtap="onAdoptCloudResult" loading="{{adopting}}" disabled="{{adopting || syncing || queueStats.syncing}}">采用云端结果</button>
      <view wx:for="{{pending}}" wx:key="_id" class="pending-item"><view class="grow"><text class="pending-name">{{item.courseName}} · {{item.label}}</text><text wx:if="{{item.payload.date}}" class="record-meta">{{item.payload.date}}</text><text wx:if="{{item.status === 'failed' && item.lastError}}" class="failure-reason">原因：{{item.lastError}}</text></view><text class="pending-badge {{item.status === 'failed' ? 'failed' : ''}}">{{item.status === 'failed' ? '待重试' : '待同步'}}</text></view>
      <text wx:if="{{queueStats.lastError}}" class="failure-reason sync-reason">同步原因：{{queueStats.lastError}}</text>
    </view>
    <view class="panel archive-panel">
      <view class="section-row"><text class="section-title">归档课程</text><text class="badge">{{archived.length}} 门</text></view>
      <view wx:if="{{!archived.length}}" class="archive-empty">{{error || offline ? '当前本机没有归档课程；连接后可核对完整记录。' : (isLoading ? '正在读取归档课程…' : '暂无归档课程，历史会一直保留。')}}</view>
      <view wx:for="{{archived}}" wx:key="_id" class="archive-row"><button class="archive-open" data-id="{{item._id}}" bindtap="onCourseTap"><view class="mini-emoji {{item.type}}">{{item.icon || '📖'}}</view><view class="grow"><text class="record-name">{{item.name}}</text><text class="record-meta">累计 {{item.completedCount}} 节 · 查看历史</text></view></button><button class="text-button restore-button" data-id="{{item._id}}" bindtap="onRestore" disabled="{{!ready}}">恢复</button></view>
    </view>
    <view class="panel menu">
      <button id="export-records" class="menu-button" bindtap="onDataExport" loading="{{exporting}}" disabled="{{!ready || exporting}}"><view class="menu-icon"><text>↓</text></view><text class="grow">导出课时表 / 完整备份</text><text class="chevron">›</text></button>
      <button class="menu-button" bindtap="onHelp"><view class="menu-icon"><text>?</text></view><text class="grow">使用说明与数据保护</text><text class="chevron">›</text></button>
      <button class="menu-button" open-type="feedback"><view class="menu-icon"><text>…</text></view><text class="grow">意见反馈</text><text class="chevron">›</text></button>
    </view>
    <view wx:if="{{legacyCount}}" class="warning"><text>发现旧版缓存，尚未确认数据归属，已保留但未自动上传。</text><button class="text-button" bindtap="onLegacyExport">导出旧版缓存备份 ›</button></view>
    <text class="profile-foot">课时小记 · 2.0 单人版\n所有记课日期按北京时间计算</text>
  </view>
</view>
