/* 空状态组件样式 */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 48rpx;
  text-align: center;
}

/* 插图区域 */
.empty-illustration {
  width: 320rpx;
  height: 320rpx;
  background: linear-gradient(135deg, #EFF6FF 0%, #F0F4FF 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(37, 99, 235, 0.1);
}

.empty-icon {
  font-size: 160rpx;
  line-height: 1;
}

/* 标题 */
.empty-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1E293B;
  margin-bottom: 16rpx;
}

/* 描述 */
.empty-desc {
  font-size: 28rpx;
  color: #64748B;
  line-height: 1.6;
  margin-bottom: 48rpx;
  max-width: 480rpx;
}

/* 按钮 */
.empty-btn {
  min-width: 240rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.empty-btn.primary {
  background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.3);
}

.empty-btn.primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.2);
}

.empty-btn.secondary {
  background: #fff;
  color: #2563EB;
  border: 2rpx solid #2563EB;
}

.empty-btn.secondary:active {
  background: #EFF6FF;
}

/* 变体样式 */
.empty-state.compact {
  padding: 48rpx 32rpx;
}

.empty-state.compact .empty-illustration {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
}

.empty-state.compact .empty-icon {
  font-size: 100rpx;
}

.empty-state.compact .empty-title {
  font-size: 32rpx;
}

.empty-state.compact .empty-desc {
  font-size: 26rpx;
  margin-bottom: 32rpx;
}