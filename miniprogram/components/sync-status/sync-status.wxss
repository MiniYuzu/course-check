.sync-status {
  box-sizing: border-box;
  margin-bottom: 28rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 24rpx;
  line-height: 1.75;
  background: #FFF5E4;
  color: #855B22;
}

.sync-status.syncing {
  color: #45628C;
  background: #EDF3FF;
}

.sync-status.failed {
  color: #A34359;
  background: #FFF0F2;
}
