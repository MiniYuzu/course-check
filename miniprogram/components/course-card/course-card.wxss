.course-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  padding: 40rpx;
  margin-bottom: 32rpx;
  border-radius: 40rpx;
  background: #64748B;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.5;
  box-shadow: 0 20rpx 44rpx rgba(37, 89, 138, 0.09);
}

.course-card::after {
  content: '';
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  top: -180rpx;
  right: -100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  pointer-events: none;
}

.card-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.course-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.25);
  font-size: 48rpx;
}

.course-info {
  flex: 1;
  min-width: 0;
}

.course-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  overflow-wrap: break-word;
}

.course-schedule {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
  opacity: 0.9;
  overflow-wrap: break-word;
}

.chevron {
  flex-shrink: 0;
  font-size: 40rpx;
  opacity: 0.8;
}

.progress-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
  justify-content: space-between;
}

.lesson-count {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: baseline;
}

.count {
  font-size: 62rpx;
  font-weight: 800;
  line-height: 1.2;
}

.count-label {
  font-size: 24rpx;
}

.progress-track {
  flex-shrink: 0;
  width: 160rpx;
  height: 12rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.3);
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.9);
}

.remaining {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.overdrawn {
  display: block;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
}

.checkin-btn {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  margin: 32rpx 0 0;
  padding: 24rpx 16rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: #1E293B;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
  box-shadow: 0 8rpx 24rpx rgba(30, 41, 59, 0.15);
}

.checkin-btn::after {
  border: 0;
}

.checkin-btn[disabled] {
  background: rgba(255, 255, 255, 0.75);
  color: #475569;
  opacity: 1;
  box-shadow: none;
}

.checkin-btn.completed,
.checkin-btn.completed[disabled] {
  background: #10B981;
  color: #FFFFFF;
}

.status {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
}
