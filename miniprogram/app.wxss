page {
  background: #F0F4FF;
  color: #1E293B;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}
view, button, input, textarea { box-sizing: border-box; }
button { margin: 0; padding: 22rpx 26rpx; border-radius: 28rpx; font-size: 28rpx; line-height: 1.5; }
button::after { border: 0; }
button[disabled] { color: #78869C; background: #E7EDF7; opacity: 1; }
.page { padding: 32rpx 36rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.page-content { padding: 36rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.hero { position: relative; overflow: hidden; padding: 44rpx 46rpx 58rpx; color: #FFFFFF; background: linear-gradient(135deg, #2563EB 0%, #7C3AED 100%); }
.hero-title { display: block; font-size: 48rpx; font-weight: 700; line-height: 1.4; }
.hero-subtitle { display: block; margin-top: 12rpx; color: rgba(255, 255, 255, 0.85); font-size: 26rpx; }
.hero-sparkle { position: absolute; right: 46rpx; top: 30rpx; color: rgba(255, 255, 255, 0.28); font-size: 80rpx; pointer-events: none; }
.panel { padding: 36rpx; background: #FFFFFF; border: 1rpx solid #E8EDF6; border-radius: 44rpx; margin-bottom: 28rpx; box-shadow: 0 14rpx 44rpx rgba(41, 68, 108, 0.045); }
.section-title { display: block; font-size: 32rpx; font-weight: 700; color: #25344D; }
.section-row, .row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.section-row { margin-bottom: 28rpx; }
.grow { flex: 1; min-width: 0; }
.muted, .hint, .subtitle { color: #64728A; font-size: 24rpx; }
.hint { display: block; margin-top: 18rpx; line-height: 1.75; }
.primary { background: linear-gradient(135deg, #2563EB 0%, #7C3AED 100%); color: #FFFFFF; font-weight: 650; }
.secondary { background: #EEF3FF; color: #2563EB; }
.text-button { background: transparent; color: #466DA9; padding: 16rpx 8rpx; min-height: 80rpx; font-size: 26rpx; flex-shrink: 0; }
.danger { color: #AE4A5C; }
.warning, .error-box { border-radius: 24rpx; padding: 24rpx; margin-bottom: 28rpx; font-size: 24rpx; line-height: 1.75; word-break: break-word; }
.warning { background: #FFF5E4; color: #855B22; }
.error-box { background: #FFF0F2; color: #A34359; }
.error-box button { margin-top: 16rpx; }
.loading, .empty { padding: 44rpx 20rpx; text-align: center; color: #64728A; font-size: 26rpx; }
.empty-title { display: block; color: #425672; font-size: 32rpx; font-weight: 600; margin-bottom: 14rpx; }
.badge { display: inline-block; font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 12rpx; background: #EDF3FF; color: #2857BD; white-space: nowrap; }
.record-row { padding: 24rpx 0; border-top: 1rpx solid #EDF1F8; }
.record-name { display: block; color: #34455F; font-weight: 600; word-break: break-word; }
.record-meta { display: block; color: #64728A; font-size: 24rpx; word-break: break-word; }
.picker { background: #EDF2FC; border-radius: 20rpx; padding: 16rpx 18rpx; color: #45628C; font-size: 24rpx; white-space: nowrap; }
.track { height: 10rpx; border-radius: 10rpx; background: #E8EDF7; overflow: hidden; }
.track-fill { height: 100%; border-radius: 10rpx; background: linear-gradient(135deg, #2563EB 0%, #06B6D4 100%); }
.mini-emoji { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 72rpx; height: 72rpx; border-radius: 22rpx; background: #EDF5FF; font-size: 38rpx; }
.mini-emoji.piano { background: #FFF1E6; }
.under-note { display: block; text-align: center; color: #64728A; font-size: 24rpx; line-height: 1.75; margin-top: 26rpx; }
